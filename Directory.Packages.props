<Project>
  <PropertyGroup>
    <FrameworkVersion Condition="'$(TargetFramework)' == 'net8.0'">[8.0.0,9.0.0)</FrameworkVersion>
    <FrameworkVersion Condition="'$(TargetFramework)' == 'net9.0'">[9.0.0,10.0.0)</FrameworkVersion>
    <FrameworkVersion Condition="'$(TargetFramework)' == 'net10.0'">[10.0.0,11.0.0)</FrameworkVersion>
    <FrameworkExtVersion Condition="'$(TargetFramework)' == 'net8.0'">[8.0.5,11.0.0)</FrameworkExtVersion>
    <FrameworkExtVersion Condition="'$(TargetFramework)' == 'net9.0'">[9.0.0,11.0.0)</FrameworkExtVersion>
    <FrameworkExtVersion Condition="'$(TargetFramework)' == 'net10.0'">[10.0.0,11.0.0)</FrameworkExtVersion>
    <NpgsqlVersion Condition="'$(TargetFramework)' == 'net8.0'">[8.0.3,11.0.0)</NpgsqlVersion>
    <NpgsqlVersion Condition="'$(TargetFramework)' == 'net9.0'">[8.0.3,11.0.0)</NpgsqlVersion>
    <NpgsqlVersion Condition="'$(TargetFramework)' == 'net10.0'">[10.0.0,11.0.0)</NpgsqlVersion>
    <RoslinatorVersion>[4.15.0,)</RoslinatorVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Npgsql"  Version="$(NpgsqlVersion)" />
  </ItemGroup>
  <ItemGroup>
    <GlobalPackageReference Include="Roslynator.Analyzers" Version="$(RoslinatorVersion)" />
    <GlobalPackageReference Include="Roslynator.CodeAnalysis.Analyzers" Version="$(RoslinatorVersion)" />
    <GlobalPackageReference Include="Roslynator.CodeFixes" Version="$(RoslinatorVersion)" />
    <GlobalPackageReference Include="Roslynator.Formatting.Analyzers" Version="$(RoslinatorVersion)" />
    <GlobalPackageReference Include="Roslynator.Refactorings" Version="$(RoslinatorVersion)" />
  </ItemGroup>
</Project>