<Project>
  <!--<Version>2.0</Version>-->
  <Import Project="$([MSBuild]::GetPathOfFileAbove(Directory.Packages.props, $(MSBuildThisFileDirectory)..))" />
  <PropertyGroup>
    <TestcontainersVersion>[4.13.0,)</TestcontainersVersion>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="AwesomeAssertions" Version="[9.5.0,)" />
    <PackageVersion Include="Bogus" Version="[35.6.5,)" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="[9.4.0,)" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="[18.10.0,)" />
    <PackageVersion Include="Moq" Version="[4.20.72,)" />
    <!-- Transitive of Testcontainers; pinned above the vulnerable 2025.1.0 (GHSA-q939-rpr3-3284). -->
    <PackageVersion Include="SSH.NET" Version="[2026.0.0,)" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="$(TestcontainersVersion)" />
    <PackageVersion Include="Testcontainers.XunitV3" Version="$(TestcontainersVersion)" />
    <PackageVersion Include="xunit.v3" Version="[4.0.0,)" />
  </ItemGroup>
</Project>
